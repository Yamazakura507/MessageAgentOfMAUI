<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MessageAgent.Controls.Lists"
    x:Class="MessageAgent.Controls.Lists.MessageStatusTextFilterView"
    x:Name="Root"
    x:DataType="controls:MessageStatusTextFilterView">
    <VerticalStackLayout Spacing="6">
        <Label
            Text="Название статуса содержит"
            FontSize="12"
            Margin="2,4,2,2"
            TextColor="{Binding LabelColor, Source={x:Reference Root}}" />
        <Entry
            Placeholder="Текст статуса"
            Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
            FontSize="13"
            ClearButtonVisibility="WhileEditing" />
    </VerticalStackLayout>
</ContentView>
