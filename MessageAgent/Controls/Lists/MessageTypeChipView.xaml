<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
             xmlns:resources="clr-namespace:MessageAgent.Resources"
             x:Class="MessageAgent.Controls.Lists.MessageTypeChipView">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <Border x:Name="ChipBorder"
            Style="{StaticResource MessageAgent.Styles.MessageTypeChipBorder}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="9" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="Auto,Auto,*" 
              ColumnSpacing="5">
            <lottie:LottieView x:Name="Animation" 
                               WidthRequest="21" 
                               HeightRequest="21"
                               Progress="1" 
                               IsPlaying="False" 
                               IsLooping="False"
                               BackgroundColor="Transparent" 
                               VerticalOptions="Center" />
            <Border x:Name="CountBadge"
                    Grid.Column="1"
                    Style="{StaticResource MessageAgent.Styles.MessageTypeCountBadge}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
                <Label x:Name="CountText"
                       Style="{StaticResource MessageAgent.Styles.MessageTypeCountLabel}" />
            </Border>
            <Label x:Name="TypeName"
                   Grid.Column="2"
                   Style="{StaticResource MessageAgent.Styles.MessageTypeNameLabel}" />
        </Grid>
    </Border>
</ContentView>