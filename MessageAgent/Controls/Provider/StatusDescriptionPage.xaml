<?xml version="1.0" encoding="utf-8" ?>
<modal:AnimatedModalPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:modal="clr-namespace:MessageAgent.Controls.Provider.Abstract"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    x:Class="MessageAgent.Controls.Provider.StatusDescriptionPage"
    BackgroundColor="Transparent"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        x:Name="Overlay"
        BackgroundColor="{StaticResource MessageAgent.Colors.StatusDescriptionOverlay}"
        RowDefinitions="*,Auto"
        Opacity="0">

        <BoxView
            Grid.RowSpan="2"
            Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="BottomSheet"
            Grid.Row="1"
            Padding="22,18,22,28"
            BackgroundColor="{AppThemeBinding Light={StaticResource MessageAgent.Colors.StatusDescriptionSurfaceLight}, Dark={StaticResource MessageAgent.Colors.StatusDescriptionSurfaceDark}}"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="500">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22,22,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">
                <BoxView Style="{StaticResource MessageAgent.Styles.StatusDescriptionGrip}" />

                <Label
                    x:Name="TitleLabel"
                    Text="{Binding DescriptionTitle}"
                    Style="{StaticResource MessageAgent.Styles.StatusDescriptionTitle}" />

                <Label
                    x:Name="DescriptionLabel"
                    Text="{Binding DescriptionText}"
                    Style="{StaticResource MessageAgent.Styles.StatusDescriptionText}" />

                <Button
                    Text="Закрыть"
                    HorizontalOptions="End"
                    Clicked="OnCloseClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</modal:AnimatedModalPage>
