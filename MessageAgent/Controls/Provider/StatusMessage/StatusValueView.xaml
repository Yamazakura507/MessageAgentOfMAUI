<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    x:Class="MessageAgent.Controls.Provider.StatusValueView"
    x:Name="Root"
    BackgroundColor="Transparent">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        x:Name="StatusBorder"
        Style="{StaticResource MessageAgent.Styles.StatusValueBorder}">

        <Border.StrokeShape>
            <shapes:RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>

        <Grid
            x:Name="StatusLayout"
            BackgroundColor="Transparent"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="4"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <ContentView
                x:Name="ValueHost"
                Grid.Column="0"
                WidthRequest="18"
                HeightRequest="18"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="NameLabel"
                Grid.Column="1"
                Style="{StaticResource MessageAgent.Styles.StatusNameLabel}"
                IsVisible="False" />
        </Grid>
    </Border>
</ContentView>
