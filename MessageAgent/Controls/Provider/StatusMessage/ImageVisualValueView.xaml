<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MessageAgent.Controls.Provider.StatusMessage.ImageVisualValueView">

    <Image
        x:Name="StatusImage"
        Source="{Binding Source}"
        SemanticProperties.Description="{Binding AlternativeText}"
        WidthRequest="18"
        HeightRequest="18"
        Aspect="AspectFit"
        HorizontalOptions="Center"
        VerticalOptions="Center" />
</ContentView>
