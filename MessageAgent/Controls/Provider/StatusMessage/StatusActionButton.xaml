<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    xmlns:statusViews="clr-namespace:MessageAgent.Controls.Provider.StatusMessage"
    x:Class="MessageAgent.Controls.Provider.StatusMessage.StatusActionButton"
    x:Name="Root"
    x:DataType="statusViews:StatusActionButton"
    BackgroundColor="Transparent">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <Border
        x:Name="ActionBorder"
        Style="{StaticResource MessageAgent.Styles.StatusActionBorder}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>
        <Grid
            x:Name="AnimationHost"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label
                x:Name="ActionLabel"
                Text="{Binding Text, Source={x:Reference Root}}"
                Style="{StaticResource MessageAgent.Styles.StatusActionLabel}"
                IsVisible="{Binding IsTextVisible, Source={x:Reference Root}}" />
            <lottie:LottieView
                x:Name="ActionAnimation"
                Source="{Binding EffectiveAnimationSource, Source={x:Reference Root}}"
                Modifiers="{Binding AnimationModifiers, Source={x:Reference Root}}"
                WidthRequest="24"
                HeightRequest="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                IsPlaying="False"
                IsLooping="False"
                IsVisible="{Binding IsAnimationVisible, Source={x:Reference Root}}" />
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
