<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
    xmlns:models="clr-namespace:MessageAgent.Core.Models.VisualValues"
    x:Class="MessageAgent.Controls.Provider.StatusMessage.LottieVisualValueView"
    x:Name="Root"
    x:DataType="models:LottieVisualValue"
    SemanticProperties.Description="{Binding AlternativeText}">

    <Grid
        WidthRequest="18"
        HeightRequest="18"
        Padding="0"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <lottie:LottieView
            x:Name="Animation"
            Source="{Binding Source}"
            Speed="{Binding Speed}"
            Progress="{Binding Progress, Mode=OneWay}"
            IsReversed="{Binding IsReverse}"
            Modifiers="{Binding Modifiers}"
            WidthRequest="18"
            HeightRequest="18"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsPlaying="False"
            IsLooping="False"
            BackgroundColor="Transparent" />
    </Grid>
</ContentView>
