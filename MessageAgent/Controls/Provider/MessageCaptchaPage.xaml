<?xml version="1.0" encoding="utf-8" ?>
<modal:AnimatedModalPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modal="clr-namespace:MessageAgent.Controls.Provider.Abstract"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
    xmlns:provider="clr-namespace:MessageAgent.Controls.Provider"
    x:Class="MessageAgent.Controls.Provider.MessageCaptchaPage"
    x:Name="Root"
    x:DataType="provider:MessageCaptchaPage"
    BackgroundColor="Transparent"
    Title="CAPTCHA">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="Overlay" Padding="24" BackgroundColor="{StaticResource MessageAgent.Colors.DetailsOverlay}" Opacity="0">
        <Border x:Name="DialogPanel"
                Padding="20"
                MaximumWidthRequest="600"
                MaximumHeightRequest="760"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                Stroke="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                StrokeThickness="1.5"
                Opacity="0"
                Scale="0.94">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="48,*,32" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="{Binding Source={x:Reference Root}, Path=DialogIconKey, Converter={StaticResource MessageAgentImageSourceConverter}}"
                               WidthRequest="42" HeightRequest="42"
                               Aspect="AspectFit"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Проверка CAPTCHA"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                            <Label Text="{Binding Source={x:Reference Root}, Path=Prompt}"
                                   FontSize="13"
                                   TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=SecondaryForeground}" />
                        </VerticalStackLayout>
                        <Border x:Name="HeaderCloseButton"
                                Grid.Column="2"
                                WidthRequest="30"
                                HeightRequest="30"
                                Padding="2"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                ToolTipProperties.Text="Закрыть">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseButtonOnClicked" />
                            </Border.GestureRecognizers>
                            <lottie:LottieView
                                x:Name="HeaderCloseAnimation"
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsPlaying="False"
                                IsLooping="False"
                                BackgroundColor="Transparent"
                                Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Close}"
                                JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                                ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="TextChallenge"
                                         IsVisible="{Binding Source={x:Reference Root}, Path=IsTextMode}"
                                         Spacing="10">
                        <Border Padding="14"
                                BackgroundColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                                Stroke="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                                StrokeThickness="1.2">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <skia:SKCanvasView x:Name="CaptchaTextCanvas"
                                               HeightRequest="86"
                                               HorizontalOptions="Fill"
                                               PaintSurface="CaptchaTextCanvasOnPaintSurface" />
                        </Border>
                        <Entry x:Name="CaptchaAnswerEntry"
                               AutomationProperties.AutomationId="message-captcha-answer"
                               SemanticProperties.Description="Ответ на CAPTCHA"
                               SemanticProperties.Hint="Введите символы, показанные выше."
                               Placeholder="Введите символы с изображения"
                               MaxLength="24"
                               ReturnType="Done" />
                    </VerticalStackLayout>

                    <Grid x:Name="ImageChallenge"
                          IsVisible="{Binding Source={x:Reference Root}, Path=IsImageMode}"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="8">
                        <AbsoluteLayout x:Name="VerticalSliderRow"
                                        Grid.Row="0"
                                        Grid.RowSpan="1"
                                        WidthRequest="44"
                                        HeightRequest="260"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding Source={x:Reference Root}, Path=ShowVerticalSlider}">
                            <Image Source="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentImageSourceConverter}, ConverterParameter=MessageAgent.Images.CaptchaDragVertical}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   Aspect="AspectFit"
                                   AbsoluteLayout.LayoutBounds="0.25,0.02,35,0"
                                   AbsoluteLayout.LayoutFlags="PositionProportional" />
                            <Slider x:Name="VerticalSlider"
                                    AutomationProperties.AutomationId="message-captcha-vertical-slider"
                                    SemanticProperties.Description="Вертикальное положение фрагмента"
                                    SemanticProperties.Hint="Перемещайте фрагмент вверх или вниз."
                                    Rotation="270"
                                    WidthRequest="210"
                                    HeightRequest="36"
                                    Minimum="0"
                                    Maximum="100"
                                    ValueChanged="VerticalSliderOnValueChanged"
                                    DragCompleted="SliderOnDragCompleted"
                                    AbsoluteLayout.LayoutBounds="-83,112,210,36" />
                        </AbsoluteLayout>

                        <Border Grid.Column="1"
                                Grid.Row="0"
                                Padding="6"
                                BackgroundColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                                Stroke="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                                StrokeThickness="1.2">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <skia:SKCanvasView x:Name="PuzzleCanvas"
                                               HeightRequest="260"
                                               HorizontalOptions="Fill"
                                               PaintSurface="PuzzleCanvasOnPaintSurface" />
                        </Border>

                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="Переместите фрагмент в пустую область. Проверка выполняется после отпускания ползунка."
                               FontSize="12"
                               TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=SecondaryForeground}" />

                        <Grid x:Name="HorizontalSliderRow"
                              IsVisible="{Binding Source={x:Reference Root}, Path=ShowHorizontalSlider}"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="28,*"
                              ColumnSpacing="8">
                            <Image Source="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentImageSourceConverter}, ConverterParameter=MessageAgent.Images.CaptchaDragHorizontal}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Slider x:Name="HorizontalSlider"
                                    AutomationProperties.AutomationId="message-captcha-horizontal-slider"
                                    SemanticProperties.Description="Горизонтальное положение фрагмента"
                                    SemanticProperties.Hint="Перемещайте фрагмент влево или вправо."
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    ValueChanged="HorizontalSliderOnValueChanged"
                                    DragCompleted="SliderOnDragCompleted" />
                        </Grid>

                        <Label x:Name="PuzzleModeLabel"
                               Text="{Binding Source={x:Reference Root}, Path=PuzzleModeText}"
                               Grid.Row="3"
                               Grid.ColumnSpan="2"
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=SecondaryForeground}" />
                    </Grid>

                    <Label x:Name="FeedbackLabel"
                           FontSize="12"
                           IsVisible="False"
                           TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="CancelButton"
                                AutomationProperties.AutomationId="message-captcha-cancel"
                                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=CancelText}"
                                Text="{Binding Source={x:Reference Root}, Path=CancelText}"
                                Clicked="CancelButtonOnClicked"
                                BackgroundColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                                BorderColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                                BorderWidth="1"
                                TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                        <Button x:Name="VerifyButton"
                                AutomationProperties.AutomationId="message-captcha-verify"
                                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=VerifyText}"
                                Grid.Column="1"
                                IsVisible="{Binding Source={x:Reference Root}, Path=ShowVerifyButton}"
                                Text="{Binding Source={x:Reference Root}, Path=VerifyText}"
                                Clicked="VerifyButtonOnClicked"
                                BackgroundColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource MessageTypeColorConverter}}"
                                TextColor="{Binding Source={x:Reference Root}, Path=DialogType, Converter={StaticResource DialogColorConverter}, ConverterParameter=AccentContent}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</modal:AnimatedModalPage>
