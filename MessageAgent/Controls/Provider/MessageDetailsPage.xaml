<?xml version="1.0" encoding="utf-8" ?>
<modal:AnimatedModalPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:modal="clr-namespace:MessageAgent.Controls.Provider.Abstract"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
    xmlns:views="clr-namespace:MessageAgent.Controls"
    xmlns:statusViews="clr-namespace:MessageAgent.Controls.Provider.StatusMessage"
    xmlns:converters="clr-namespace:MessageAgent.Converters"
    x:Class="MessageAgent.Controls.Provider.MessageDetailsPage"
    x:Name="Root"
    BackgroundColor="Transparent"
    Title="Message details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MessageTypeColorConverter x:Key="AccentColorConverter" />
            <converters:MessageTypeToDialogColorConverter x:Key="DialogColorConverter" />
            <converters:MessageTypeToTextConverter x:Key="MessageTypeToTextConverter" />
            <converters:MessageTypeToLottieModifiersConverter x:Key="LottieModifiersConverter" />
            <converters:ReadStateConverter x:Key="ReadStateConverter" />
            <converters:MessageAgentImageSourceConverter x:Key="MessageAgentImageSourceConverter" />
            <converters:MessageAgentLottieSourceConverter x:Key="MessageAgentLottieSourceConverter" />
            <converters:HasTextConverter x:Key="HasTextConverter" />
            <converters:CollectionCountConverter x:Key="HasItemsConverter" MinimumCount="1" />
            <converters:CollectionCountConverter x:Key="HasMultipleItemsConverter" MinimumCount="2" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="Overlay" Padding="24" BackgroundColor="#96000000" Opacity="0">
        <Border
            x:Name="DetailsPanel"
            Padding="20"
            MaximumWidthRequest="560"
            MaximumHeightRequest="720"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
            Stroke="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
            StrokeThickness="1.5"
            Opacity="0"
            Scale="0.94">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="56,*,32" ColumnSpacing="12">
                        <lottie:LottieView
                            x:Name="MessageIcon"
                            Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="52"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsPlaying="False"
                            IsLooping="False"
                            Progress="1"
                            Source="{Binding Type.NotificationAnimationSource}"
                            JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                            ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}"
                            Modifiers="{Binding Type, Converter={StaticResource LottieModifiersConverter}}" />
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3" VerticalOptions="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label
                                    Text="{Binding Type, Converter={StaticResource MessageTypeToTextConverter}}"
                                    TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                                    FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Image
                                        Source="{Binding IsRead, Converter={StaticResource ReadStateConverter}, ConverterParameter=Image}"
                                        WidthRequest="16" HeightRequest="16" Aspect="AspectFit" />
                                    <Image
                                        Source="{Binding IsImportant, Converter={StaticResource MessageAgentImageSourceConverter}, ConverterParameter=MessageAgent.Images.Important}"
                                        WidthRequest="16" HeightRequest="16"
                                        Aspect="AspectFit"
                                        IsVisible="{Binding IsImportant}"
                                        ToolTipProperties.Text="Важное сообщение" />
                                    <Label
                                        Text="{Binding IsRead, Converter={StaticResource ReadStateConverter}}"
                                        FontSize="11"
                                        TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=SecondaryForeground}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label
                                Grid.Row="1"
                                Text="{Binding Title}"
                                FontSize="20" FontAttributes="Bold"
                                TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Foreground}"
                                LineBreakMode="WordWrap" />
                        </Grid>
                        <Border
                            x:Name="HeaderCloseButton"
                            Grid.Column="2"
                            WidthRequest="30"
                            HeightRequest="30"
                            Padding="2"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            ToolTipProperties.Text="Закрыть">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseButtonOnClicked" />
                            </Border.GestureRecognizers>
                            <lottie:LottieView
                                x:Name="HeaderCloseAnimation"
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsPlaying="False"
                                IsLooping="False"
                                BackgroundColor="Transparent"
                                Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Close}"
                                JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                                ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}" />
                        </Border>
                    </Grid>

                    <statusViews:StatusGridView
                        Items="{Binding Status}"
                        AccentColor="{Binding Type, Converter={StaticResource AccentColorConverter}}"
                        IsPaged="True" HorizontalOptions="Fill"
                        IsVisible="{Binding Status, Converter={StaticResource HasItemsConverter}}" />

                    <Label
                        Text="{Binding Description}"
                        FontSize="14"
                        TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Foreground}"
                        LineBreakMode="WordWrap"
                        IsVisible="{Binding Description, Converter={StaticResource HasTextConverter}}" />

                    <CollectionView
                        ItemsSource="{Binding Links}"
                        SelectionMode="None"
                        IsVisible="{Binding Links, Converter={StaticResource HasItemsConverter}}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    ColumnDefinitions="28,*"
                                    ColumnSpacing="10"
                                    Padding="8,6"
                                    BackgroundColor="{Binding Source={x:Reference Root}, Path=LinkRowBackground}"
                                    BindingContextChanged="LinkRowOnBindingContextChanged"
                                    ToolTipProperties.Text="{Binding Description}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="LinkOnTapped" />
                                    </Grid.GestureRecognizers>
                                    <ContentView
                                        x:Name="LinkVisualHost"
                                        Grid.Column="0"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding DisplayText}"
                                        FontSize="14"
                                        TextDecorations="Underline"
                                        TextColor="{Binding Source={x:Reference Root}, Path=DialogAccentColor}"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid
                        x:Name="ImagesCarouselHost"
                        HeightRequest="220"
                        ColumnDefinitions="36,*,36"
                        IsVisible="{Binding Images, Converter={StaticResource HasItemsConverter}}">
                        <lottie:LottieView
                            x:Name="PreviousImageArrow"
                            Grid.Column="0"
                            Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Arrow}"
                            WidthRequest="64" HeightRequest="64"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            IsPlaying="False" IsLooping="False"
                            JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                            ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}">
                            <lottie:LottieView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PreviousImageOnTapped" />
                            </lottie:LottieView.GestureRecognizers>
                        </lottie:LottieView>

                        <CarouselView
                            x:Name="ImagesCarousel"
                            Grid.Column="1"
                            Loop="False"
                            IsBounceEnabled="False"
                            ItemsSource="{Binding Images}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            PositionChanged="ImagesCarouselOnPositionChanged"
                            IndicatorView="{x:Reference ImagesIndicator}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Image Source="{Binding .}" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <lottie:LottieView
                            x:Name="NextImageArrow"
                            Grid.Column="2"
                            Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Arrow}"
                            WidthRequest="64" HeightRequest="64"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            IsPlaying="False" IsLooping="False"
                            JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                            ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}">
                            <lottie:LottieView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NextImageOnTapped" />
                            </lottie:LottieView.GestureRecognizers>
                        </lottie:LottieView>
                    </Grid>

                    <IndicatorView
                        x:Name="ImagesIndicator"
                        HorizontalOptions="Center"
                        IndicatorColor="LightGray"
                        SelectedIndicatorColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                        IsVisible="{Binding Images, Converter={StaticResource HasMultipleItemsConverter}}" />

                    <Border
                        x:Name="CloseButton"
                        Padding="14,9"
                        BackgroundColor="{Binding Type, Converter={StaticResource AccentColorConverter}}"
                        StrokeThickness="0"
                        HorizontalOptions="End">
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseButtonOnClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <lottie:LottieView
                                x:Name="CloseAnimation"
                                Grid.Column="0"
                                Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Close}"
                                JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                                ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}"
                                WidthRequest="24" HeightRequest="24"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                IsPlaying="False" IsLooping="False"
                                BackgroundColor="Transparent" />
                            <Label
                                Grid.Column="1"
                                Text="Закрыть"
                                FontSize="14"
                                TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=AccentContent}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</modal:AnimatedModalPage>
