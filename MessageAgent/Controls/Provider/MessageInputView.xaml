<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    x:Class="MessageAgent.Controls.Provider.MessageInputView"
    x:Name="Root">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <VerticalStackLayout Spacing="7">
        <Entry x:Name="SingleLineInput"
               Placeholder="Введите значение"
               ReturnType="Done"
               TextChanged="InputTextChanged" />
        <Editor x:Name="MultiLineInput"
                IsVisible="False"
                Placeholder="Введите значение"
                AutoSize="TextChanges"
                MinimumHeightRequest="110"
                TextChanged="InputTextChanged" />
        <Label x:Name="ValidationLabel"
               IsVisible="False"
               FontSize="12"
               TextColor="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentColorConverter}, ConverterParameter=MessageAgent.Colors.ValidationError}" />
    </VerticalStackLayout>
</ContentView>