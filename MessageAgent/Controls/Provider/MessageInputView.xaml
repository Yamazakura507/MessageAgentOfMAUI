<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    xmlns:controls="clr-namespace:MessageAgent.Controls.Provider"
    x:Class="MessageAgent.Controls.Provider.MessageInputView"
    x:Name="Root"
    x:DataType="controls:MessageInputView">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <VerticalStackLayout Spacing="7">
        <Entry x:Name="SingleLineInput"
               AutomationProperties.AutomationId="message-input-single-line"
               SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=AccessibilityName}"
               SemanticProperties.Hint="Введите значение в одну строку."
               Placeholder="Введите значение"
               ReturnType="Done"
               TextChanged="InputTextChanged" />
        <Editor x:Name="MultiLineInput"
                AutomationProperties.AutomationId="message-input-multiline"
                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=AccessibilityName}"
                SemanticProperties.Hint="Введите многострочный текст."
                IsVisible="False"
                Placeholder="Введите значение"
                AutoSize="TextChanges"
                MinimumHeightRequest="110"
                TextChanged="InputTextChanged" />
        <Label x:Name="ValidationLabel"
               IsVisible="False"
               FontSize="12"
               TextColor="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentColorConverter}, ConverterParameter=MessageAgent.Colors.ValidationError}" />
    </VerticalStackLayout>
</ContentView>