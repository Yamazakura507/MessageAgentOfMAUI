<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MessageAgent.Controls.Provider.MessageInputView">
    <VerticalStackLayout Spacing="7">
        <Entry x:Name="SingleLineInput"
               Placeholder="Введите значение"
               ReturnType="Done"
               TextChanged="InputTextChanged" />
        <Editor x:Name="MultiLineInput"
                IsVisible="False"
                Placeholder="Введите значение"
                AutoSize="TextChanges"
                MinimumHeightRequest="110"
                TextChanged="InputTextChanged" />
        <Label x:Name="ValidationLabel"
               IsVisible="False"
               FontSize="12"
               TextColor="#C62828" />
    </VerticalStackLayout>
</ContentView>