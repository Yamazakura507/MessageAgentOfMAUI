<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MessageAgent.Controls.Provider.MessageQuestionView"
    x:Name="Root">
    <FlexLayout Direction="Row"
                Wrap="Wrap"
                JustifyContent="SpaceEvenly"
                AlignItems="Center"
                BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Button Text="{Binding Text}"
                        CommandParameter="{Binding .}"
                        MinimumWidthRequest="100"
                        Margin="4"
                        CornerRadius="10"
                        BackgroundColor="{Binding Source={x:Reference Root}, Path=AccentColor}"
                        TextColor="{Binding Source={x:Reference Root}, Path=AccentContentColor}"
                        Clicked="ChoiceButtonOnClicked">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPrimary}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="BorderColor" Value="{Binding Source={x:Reference Root}, Path=AccentColor}" />
                            <Setter Property="BorderWidth" Value="1" />
                            <Setter Property="TextColor" Value="{Binding Source={x:Reference Root}, Path=AccentColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDestructive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#B3261E" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>