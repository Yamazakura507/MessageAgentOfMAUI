<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    xmlns:controls="clr-namespace:MessageAgent.Controls.Provider"
    xmlns:models="clr-namespace:MessageAgent.Core.Models.Dialogs"
    x:Class="MessageAgent.Controls.Provider.MessageQuestionView"
    x:Name="Root"
    x:DataType="controls:MessageQuestionView">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <FlexLayout Direction="Row"
                Wrap="Wrap"
                JustifyContent="SpaceEvenly"
                AlignItems="Center"
                BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:MessageQuestionButton">
                <Button Text="{Binding Text}"
                        SemanticProperties.Description="{Binding Text}"
                        SemanticProperties.Hint="Выбрать этот вариант."
                        CommandParameter="{Binding .}"
                        MinimumWidthRequest="100"
                        Margin="4"
                        CornerRadius="10"
                        BackgroundColor="{Binding Source={x:Reference Root}, Path=Type, Converter={StaticResource MessageTypeColorConverter}}"
                        TextColor="{Binding Source={x:Reference Root}, Path=Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=AccentContent}"
                        Clicked="ChoiceButtonOnClicked">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPrimary}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="BorderColor" Value="{Binding Source={x:Reference Root}, Path=Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                            <Setter Property="BorderWidth" Value="1" />
                            <Setter Property="TextColor" Value="{Binding Source={x:Reference Root}, Path=Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDestructive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentColorConverter}, ConverterParameter=MessageAgent.Colors.DestructiveAccent}" />
                            <Setter Property="TextColor" Value="{Binding Source={x:Reference Root}, Path=., Converter={StaticResource MessageAgentColorConverter}, ConverterParameter=MessageAgent.Colors.DestructiveForeground}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>