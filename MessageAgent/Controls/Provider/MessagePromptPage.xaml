<?xml version="1.0" encoding="utf-8" ?>
<modal:AnimatedModalPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modal="clr-namespace:MessageAgent.Controls.Provider.Abstract"
    xmlns:resources="clr-namespace:MessageAgent.Resources"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:lottie="clr-namespace:LottieAgent.Controls;assembly=LottieAgent"
    xmlns:models="clr-namespace:MessageAgent.Core.Models"
    x:Class="MessageAgent.Controls.Provider.MessagePromptPage"
    x:Name="Root"
    x:DataType="models:Message"
    BackgroundColor="Transparent"
    Title="Message prompt">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:DefaultResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="Overlay" Padding="24" BackgroundColor="{StaticResource MessageAgent.Colors.DetailsOverlay}" Opacity="0">
        <Border x:Name="DialogPanel"
                Padding="20"
                MaximumWidthRequest="540"
                MaximumHeightRequest="680"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                Stroke="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                StrokeThickness="1.5"
                Opacity="0"
                Scale="0.94">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="52,*,32" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="{Binding Source={x:Reference Root}, Path=DialogIconKey, Converter={StaticResource MessageAgentImageSourceConverter}}"
                               WidthRequest="44" HeightRequest="44"
                               Aspect="AspectFit"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource MessageAgent.Styles.DialogTitleLabel}"
                                   TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Foreground}" />
                            <Label Text="{Binding Description}"
                                   Style="{StaticResource MessageAgent.Styles.DialogBodyLabel}"
                                   TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=SecondaryForeground}"
                                   IsVisible="{Binding Description, Converter={StaticResource HasTextConverter}}" />
                        </VerticalStackLayout>
                        <Border x:Name="HeaderCloseButton"
                                Grid.Column="2"
                                WidthRequest="30"
                                HeightRequest="30"
                                Padding="2"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                ToolTipProperties.Text="Закрыть">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseButtonOnClicked" />
                            </Border.GestureRecognizers>
                            <lottie:LottieView
                                x:Name="HeaderCloseAnimation"
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsPlaying="False"
                                IsLooping="False"
                                BackgroundColor="Transparent"
                                Source="{Binding ., Converter={StaticResource MessageAgentLottieSourceConverter}, ConverterParameter=MessageAgent.Lotties.Close}"
                                JsonLoader="{Binding JsonLoader, Source={x:Reference Root}}"
                                ModifierProcessor="{Binding ModifierProcessor, Source={x:Reference Root}}" />
                        </Border>
                    </Grid>
                    <ContentView x:Name="PromptContent" />
                    <Grid x:Name="FooterButtons"
                          IsVisible="{Binding Source={x:Reference Root}, Path=ShowFooter}"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button x:Name="CancelActionButton"
                                AutomationProperties.AutomationId="message-prompt-cancel"
                                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=CancelText}"
                                Text="{Binding Source={x:Reference Root}, Path=CancelText}"
                                Clicked="CancelButtonOnClicked"
                                BackgroundColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Surface}"
                                BorderColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}"
                                BorderWidth="1"
                                TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=Accent}" />
                        <Button x:Name="AcceptActionButton"
                                AutomationProperties.AutomationId="message-prompt-accept"
                                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=AcceptText}"
                                Grid.Column="1"
                                Text="{Binding Source={x:Reference Root}, Path=AcceptText}"
                                
                                BackgroundColor="{Binding Type, Converter={StaticResource MessageTypeColorConverter}}"
                                TextColor="{Binding Type, Converter={StaticResource DialogColorConverter}, ConverterParameter=AccentContent}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</modal:AnimatedModalPage>